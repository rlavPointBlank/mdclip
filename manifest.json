{
  "manifest_version": 3,
  "name": "mdclip \u2014 Copy page as Markdown",
  "version": "1.1.0",
  "description": "Copy the current page as clean Markdown, ready to paste into a chat. Local only; no network access, no standing site permissions.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Copy page as Markdown (Alt+Shift+M) \u2014 reader mode: Alt+Shift+R",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "copy-as-markdown": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Copy whole page as Markdown"
    },
    "copy-article-markdown": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Copy main content only (reader mode)"
    }
  }
}
